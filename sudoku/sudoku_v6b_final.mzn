include "globals.mzn";

% =========================================================
% DATOS
% =========================================================

array[1..9, 1..9] of int: puzzle;


% =========================================================
% VARIABLES DE DECISIÓN
% =========================================================

array[1..9, 1..9] of var 1..9: x;


% =========================================================
% PISTAS
% =========================================================

constraint
    forall(i, j in 1..9 where puzzle[i,j] != 0)(
        x[i,j] = puzzle[i,j]
    );


% =========================================================
% RESTRICCIONES DE SUDOKU
% =========================================================

constraint
    forall(i in 1..9)(
        all_different([x[i,j] | j in 1..9])
    );

constraint
    forall(j in 1..9)(
        all_different([x[i,j] | i in 1..9])
    );

constraint
    forall(br, bc in 0..2)(
        all_different([
            x[br*3 + r, bc*3 + c]
            | r, c in 1..3
        ])
    );


% =========================================================
% SYMMETRY BREAKING
% =========================================================

constraint
    lex_lesseq(
        [x[1,j] | j in 1..9],
        [x[2,j] | j in 1..9]
    );

constraint
    lex_lesseq(
        [x[2,j] | j in 1..9],
        [x[3,j] | j in 1..9]
    );


% =========================================================
% BÚSQUEDA
% =========================================================

solve :: int_search(
    [x[i,j] | i,j in 1..9],
    input_order,
    indomain_min,
    complete
) satisfy;


% =========================================================
% SALIDA
% =========================================================

output [
    show(x[i,j]) ++
    if j = 9 then "\n" else " " endif
    | i,j in 1..9
];